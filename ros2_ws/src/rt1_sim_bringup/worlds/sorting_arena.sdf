<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="sorting_arena">
    <!-- 1 ms physics step -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- Mandatory Gazebo Harmonic system plugins -->
    <!-- G2 fallback 1: DART ignores <kp>/<kd>; test Bullet-Featherstone. -->
    <!-- <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine><filename>gz-physics-bullet-featherstone-plugin</filename></engine>
    </plugin> -->
           <!-- Physics: DART (default). G2: neither DART nor Bullet honours <kp>/<kd>,
            and Bullet broke arm control and joint limits (13 Nov). Block
            stiffness comes from spring joints; finger coupling from equal damping. -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

        <!-- Diagnostics (G2, 14 Nov): lets us push a link with a known force
         via /world/sorting_arena/wrench/persistent, to test the plate springs
         without the fingers. -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"/>

    <!-- Fixed directional overhead lighting -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 3 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Tabletop: top surface flush at z = 0.0 m -->
    <model name="work_table">
      <static>true</static>
      <pose>0.15 0 -0.025 0 0 0</pose>
      <link name="table_link">
        <collision name="table_collision">
          <geometry><box><size>1.0 1.2 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="table_visual">
          <geometry><box><size>1.0 1.2 0.05</size></box></geometry>
          <material>
            <ambient>0.88 0.88 0.90 1</ambient>
            <diffuse>0.88 0.88 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Visual Spawn Marker at (0.20, 0.0) m (no collision) -->
    <model name="spawn_marker">
      <static>true</static>
      <pose>0.20 0.0 0.0005 0 0 0</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry><box><size>0.06 0.06 0.001</size></box></geometry>
          <material>
            <ambient>0.95 0.80 0.10 1</ambient>
            <diffuse>0.95 0.80 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Left Bin (+Y) at (0.12, 0.20) m -->
    <model name="left_bin">
      <static>true</static>
      <pose>0.12 0.20 0.0 0 0 0</pose>
      <link name="bin_link">
        <collision name="bottom_col"><pose>0 0 0.0025 0 0 0</pose><geometry><box><size>0.12 0.12 0.005</size></box></geometry></collision>
        <visual name="bottom_vis"><pose>0 0 0.0025 0 0 0</pose><geometry><box><size>0.12 0.12 0.005</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
        <collision name="wall_px"><pose>0.0575 0 0.015 0 0 0</pose><geometry><box><size>0.005 0.12 0.03</size></box></geometry></collision>
        <visual name="wall_px_v"><pose>0.0575 0 0.015 0 0 0</pose><geometry><box><size>0.005 0.12 0.03</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
        <collision name="wall_nx"><pose>-0.0575 0 0.015 0 0 0</pose><geometry><box><size>0.005 0.12 0.03</size></box></geometry></collision>
        <visual name="wall_nx_v"><pose>-0.0575 0 0.015 0 0 0</pose><geometry><box><size>0.005 0.12 0.03</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
        <collision name="wall_py"><pose>0 0.0575 0.015 0 0 0</pose><geometry><box><size>0.11 0.005 0.03</size></box></geometry></collision>
        <visual name="wall_py_v"><pose>0 0.0575 0.015 0 0 0</pose><geometry><box><size>0.11 0.005 0.03</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
        <collision name="wall_ny"><pose>0 -0.0575 0.015 0 0 0</pose><geometry><box><size>0.11 0.005 0.03</size></box></geometry></collision>
        <visual name="wall_ny_v"><pose>0 -0.0575 0.015 0 0 0</pose><geometry><box><size>0.11 0.005 0.03</size></box></geometry>
          <material><ambient>0.15 0.45 0.85 1</ambient><diffuse>0.15 0.45 0.85 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Right Bin (-Y) at (0.12, -0.20) m -->
    <model name="right_bin">
      <static>true</static>
      <pose>0.12 -0.20 0.0 0 0 0</pose>
      <link name="bin_link">
        <collision name="bottom_col"><pose>0 0 0.0025 0 0 0</pose><geometry><box><size>0.12 0.12 0.005</size></box></geometry></collision>
        <visual name="bottom_vis"><pose>0 0 0.0025 0 0 0</pose><geometry><box><size>0.12 0.12 0.005</size></box></geometry>
          <material><ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse></material>
        </visual>
        <collision name="wall_px"><pose>0.0575 0 0.015 0 0 0</pose><geometry><box><size>0.005 0.12 0.03</size></box></geometry></collision>
        <visual name="wall_px_v"><pose>0.0575 0 0.015 0 0 0</pose><geometry><box><size>0.005 0.12 0.03</size></box></geometry>
          <material><ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse></material>
        </visual>
        <collision name="wall_nx"><pose>-0.0575 0 0.015 0 0 0</pose><geometry><box><size>0.005 0.12 0.03</size></box></geometry></collision>
        <visual name="wall_nx_v"><pose>-0.0575 0 0.015 0 0 0</pose><geometry><box><size>0.005 0.12 0.03</size></box></geometry>
          <material><ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse></material>
        </visual>
        <collision name="wall_py"><pose>0 0.0575 0.015 0 0 0</pose><geometry><box><size>0.11 0.005 0.03</size></box></geometry></collision>
        <visual name="wall_py_v"><pose>0 0.0575 0.015 0 0 0</pose><geometry><box><size>0.11 0.005 0.03</size></box></geometry>
          <material><ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse></material>
        </visual>
        <collision name="wall_ny"><pose>0 -0.0575 0.015 0 0 0</pose><geometry><box><size>0.11 0.005 0.03</size></box></geometry></collision>
        <visual name="wall_ny_v"><pose>0 -0.0575 0.015 0 0 0</pose><geometry><box><size>0.11 0.005 0.03</size></box></geometry>
          <material><ambient>0.85 0.25 0.20 1</ambient><diffuse>0.85 0.25 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>